{
    "name": "fixzy/kriptobot",
    "description": "Fixzy Kriptobot — self-hosted crypto trading bot with rule-based engine, DCA, AI market analysis, and backtesting",
    "type": "project",
    "require": {
        "doctrine/dbal": "^4.4",
        "ccxt/ccxt": "^4.5",
        "guzzlehttp/guzzle": "^7.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Fixzy\\Kriptobot\\": "src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Fixzy\\Kriptobot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "phpstan": "phpstan analyse",
        "audit": "composer audit"
    }
}