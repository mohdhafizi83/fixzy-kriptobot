# .env.example — Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# NEVER commit your real .env — it is gitignored for a reason. All secrets below
# are per-installation: generate/obtain your own, and never reuse anyone else's.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Any random secret string used internally by the app session layer.
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change…ring
APP_ENV=development

# -----------------------------------------------------------------------------
# Database (SQLite)
# -----------------------------------------------------------------------------
DB_DRIVER=pdo_sqlite
# Absolute path to the SQLite file. Create the directory first if needed.
DB_PATH=/absolute/path/to/kriptobot/database/kriptobot.sqlite
DB_NAME=kriptobot

# -----------------------------------------------------------------------------
# API security — AES-256 master key (32 bytes, base64 encoded)
# Used to encrypt stored API credentials at rest.
# Generate: php -r "echo 'base64:' . base64_encode(random_bytes(32));"
# -----------------------------------------------------------------------------
AES_MASTER_KEY=

# -----------------------------------------------------------------------------
# TradingView webhook (optional — only if you use TradingView alerts)
# A shared secret your TradingView alert payload must carry:
#   {"secret":"<same value>", ...}
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
TRADINGVIEW_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Exchange — Binance
# -----------------------------------------------------------------------------
# Trading mode: 1 = Binance Spot Testnet (DEFAULT, safe, fake money).
#               0 = live trading with REAL money. Only set 0 when you fully
#               accept the risk and have configured live keys.
BINANCE_TESTNET=1
#
# Binance API keys are entered through the app (Settings / bot configuration),
# stored encrypted in the database with AES_MASTER_KEY — not in this file.
#
#   Testnet keys (free, fake money):
#     1. Go to https://testnet.binance.vision
#     2. Log in with GitHub (or create an account)
#     3. Click "Generate HMAC_SHA256 Key"
#     4. Copy the API Key + Secret into the app
#     Note: testnet balances are reset periodically; keys expire after 3 months.
#
#   Live keys (REAL money — only if you set BINANCE_TESTNET=0):
#     1. Log in at https://www.binance.com -> Account -> API Management
#     2. Create an API key; restrict permissions (enable spot trading only,
#        DISABLE withdrawals) and whitelist your server IP if possible.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Telegram notifications (optional)
# -----------------------------------------------------------------------------
# Bot token: message @BotFather on Telegram -> /newbot -> follow prompts ->
#            copy the HTTP API token it gives you.
TELEGRAM_BOT_TOKEN=
# Your numeric chat ID: message @userinfobot on Telegram and it replies with your ID.
# (For a group: add the bot to the group, then get the group's negative ID the
#  same way, or send a message and check the bot's getUpdates response.)
TELEGRAM_CHAT_ID=
# Secret used to protect the Telegram webhook endpoint.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI / LLM (optional — powers the AI agent and news sentiment analysis)
# -----------------------------------------------------------------------------
# Any provider that speaks the OpenAI chat-completions format works:
# DeepSeek, OpenRouter, OpenAI, Groq, Mistral, Ollama, vLLM, LM Studio, etc.
#
# AI_API_KEY  — your provider API key (sent as "Authorization: Bearer <key>").
#               Get one from your provider's dashboard, e.g.:
#                 DeepSeek:    https://platform.deepseek.com -> API Keys
#                 OpenRouter:  https://openrouter.ai/keys
#                 OpenAI:      https://platform.openai.com/api-keys
#                 Groq:        https://console.groq.com/keys
#               Without a key, AI features are disabled.
AI_API_KEY=
# AI_BASE_URL — the provider's OpenAI-compatible base URL.
#               Leave empty to default to https://api.deepseek.com/
#               Examples:
#                 https://openrouter.ai/api/v1
#                 https://api.openai.com/v1
#                 https://api.groq.com/openai/v1
#                 http://localhost:11434/v1        (Ollama)
#                 http://localhost:1234/v1         (LM Studio)
AI_BASE_URL=
# AI_MODEL    — model id for your provider, e.g.
#               deepseek-chat, deepseek-reasoner, llama3.1:70b,
#               meta-llama/llama-3.1-70b-instruct (OpenRouter), gpt-4o-mini...
#               Note: native tool calling requires a model that supports it;
#               otherwise the agent falls back to prompt-based (ReAct) mode.
AI_MODEL=
# CryptoPanic API key — news sentiment feed. Without it news features are off.
# Get one: https://www.cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# -----------------------------------------------------------------------------
# Development seeding only (leave empty in production)
# -----------------------------------------------------------------------------
# Note: admin credentials are no longer seeded from here. On first run, open the
# Web UI (you will be redirected to the setup wizard) or run:
#   php bin/kriptobot setup
DEV_ADMIN_EMAIL=admin@kriptobot.local
